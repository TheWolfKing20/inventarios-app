# ===== InventariosApp - Configuración de despliegue (versión hosteada) =====
#
# COPIA este archivo a `.env` y rellena los valores.
# Si no defines DATABASE_URL, la app usa archivos JSON locales (bajo server/data),
# igual que la versión local. En un host gratuito (Render/Railway) el filesystem
# es EFÍMERO, así que SIEMPRE define DATABASE_URL apuntando a PostgreSQL
# (Supabase, Neon o la base creada por el propio Render).

# Cadena de conexión PostgreSQL (requerida en el host)
DATABASE_URL=postgresql://usuario:password@host:puerto/inventariosapp?sslmode=require

# Clave secreta para firmar los JWT (usa una aleatoria de 32+ caracteres)
JWT_SECRET=cambia_esta_clave_por_una_larga_y_secreta_porfavor

# Contraseña inicial del usuario admin (solo se usa la primera vez, si no existe)
ADMIN_PASSWORD=admin123

# Origen permitido para CORS. En producción usa la URL de tu front/sitio.
# Para simplificar (front servido por el mismo server + APK) usa '*'
CORS_ORIGIN=*

# Puerto (Render lo asigna automáticamente con la variable PORT; no lo cambies)
# PORT=3000
